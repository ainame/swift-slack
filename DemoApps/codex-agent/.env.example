# Slack Configuration (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Use a signing secret instead of an app token with the HummingbirdHTTPAdapter trait
# SLACK_SIGNING_SECRET=your-signing-secret
# HOST=0.0.0.0
# PORT=8080

# Agent backend: "codex" runs the Codex CLI through swift-codex, "mock" replays a scripted turn
AGENT_BACKEND=codex

# Required with the codex backend: the Slack user IDs the agent answers, comma-separated
ALLOWED_USER_IDS=U0123456789

# Required with the codex backend: the directory Codex works in. It must not contain this app's
# directory or a .env file.
CODEX_WORKSPACE=/path/to/a/repository

# Optional Codex settings
# CODEX_PATH=/opt/homebrew/bin/codex
# CODEX_MODEL=gpt-5-codex
