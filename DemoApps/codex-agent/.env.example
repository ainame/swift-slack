# Slack Configuration (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Use a signing secret instead of an app token with the HummingbirdHTTPAdapter trait
# SLACK_SIGNING_SECRET=your-signing-secret
# HOST=0.0.0.0
# PORT=8080

# Optional: the Slack user IDs the agent answers, comma-separated. Unset answers everyone.
# ALLOWED_USER_IDS=U0123456789

# Optional: a repository for Codex to answer questions about. It must not contain this app's
# directory or a .env file. Unset runs Codex in an empty directory.
# CODEX_WORKSPACE=/path/to/a/repository

# Optional: enable writable Code channel sessions in isolated clones of CODEX_WORKSPACE.
# This directory must be outside the source repository. Other conversations stay read-only.
# Persistent Git worktrees and channel/conversation records; outside CODEX_WORKSPACE.
# CODEX_SESSION_WORKSPACES=/path/to/agent-session-worktrees

# Optional Codex settings
# CODEX_PATH=/opt/homebrew/bin/codex
# CODEX_MODEL=gpt-5-codex
